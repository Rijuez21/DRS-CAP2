# Copy this file to .env and fill in values from your Railway MySQL service's
# "Variables" tab (or "Connect" tab). Railway names the full connection string
# MYSQL_URL or MYSQL_PUBLIC_URL — either works here.
#
# When this server is deployed AS A RAILWAY SERVICE in the same project as the
# database, Railway injects these variables automatically and you don't need
# to set them by hand in production — only for local development.

MYSQL_URL=switchback.proxy.rlwy.net:57828

# Add a Redis service in the same Railway project (New → Database → Redis)
# and copy its connection string here. Used to cache active trips and the
# latest known location per bus (paper, Table 10).
REDIS_URL=shinkansen.proxy.rlwy.net:31650

# Port the Express server listens on locally.
PORT=4000

# Secret used to sign/verify the JWTs issued by POST /api/auth/login (see
# middleware/auth.js). Set a real random value in production — the code
# falls back to a dev-only default if this is unset, which is fine for
# local development but must not be relied on when deployed.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (your Vite dev
# server and your deployed frontend URL). Also used for the Socket.io CORS policy.
CORS_ORIGIN=http://localhost:5173

# ---- GPS tracker (SinoTrack ST-906L) --------------------------------
# The tracker connects straight to this server over TCP (services/
# gpsGateway.js). Port the server listens on for it; "off" disables.
GPS_TCP_PORT=5013
# The address the tracker must be told by SMS ("8040000 <host> <port>"):
# this server's PUBLIC address as seen from the internet — e.g. the Railway
# TCP proxy host/port for GPS_TCP_PORT, or your router's public IP with the
# port forwarded. Shown on the admin GPS Tracker page.
GPS_PUBLIC_HOST=
GPS_PUBLIC_PORT=

# Optional alternative: run Traccar in front of the tracker and have it
# forward positions to POST /api/tracking/device. This is the shared secret
# Traccar must send as a header — in Traccar's traccar.xml:
#   <entry key='forward.enable'>true</entry>
#   <entry key='forward.type'>json</entry>
#   <entry key='forward.url'>https://<this server>/api/tracking/device</entry>
#   <entry key='forward.header'>X-Device-Key: <same value as below></entry>
#   <entry key='forward.retry.enable'>true</entry>
# Leave unset to turn the endpoint off. Use a long random value.
GPS_DEVICE_KEY=

# ---- Email (payment receipts + forgot-password codes) -------------------
# services/mailer.js. Set ONE of the two options below. With neither set
# (local development) nothing is sent and each email, including reset
# codes, is printed to the server console instead.
#
# Option A — Brevo HTTPS API. USE THIS ON RAILWAY: Railway blocks outbound
# SMTP on non-Pro plans (SMTP there fails with "Connection timeout").
# Free at brevo.com (300 emails/day). Verify MAIL_FROM_EMAIL as a sender in
# Brevo (Senders, Domains & Dedicated IPs -> Senders), then create a key in
# SMTP & API -> API Keys. When set, it's used instead of SMTP.
BREVO_API_KEY=
#
# Option B — plain SMTP, e.g. Gmail: turn on 2-Step Verification for the
# sending account, create an App Password (Google Account -> Security ->
# App passwords) and use it as SMTP_PASS. Your normal password won't work.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# The From line. MAIL_FROM_EMAIL defaults to SMTP_USER.
MAIL_FROM_NAME=D' Rising Sun Transport
MAIL_FROM_EMAIL=
# The frontend's public URL, used for "View receipt" links in emails.
# Defaults to the first CORS_ORIGIN.
APP_URL=
