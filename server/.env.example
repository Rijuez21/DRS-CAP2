# Copy this file to .env and fill in values from your Railway MySQL service's
# "Variables" tab (or "Connect" tab). Railway names the full connection string
# MYSQL_URL or MYSQL_PUBLIC_URL — either works here.
#
# When this server is deployed AS A RAILWAY SERVICE in the same project as the
# database, Railway injects these variables automatically and you don't need
# to set them by hand in production — only for local development.

MYSQL_URL=switchback.proxy.rlwy.net:57828

# Add a Redis service in the same Railway project (New → Database → Redis)
# and copy its connection string here. Used to cache active trips and the
# latest known location per bus (paper, Table 10).
REDIS_URL=shinkansen.proxy.rlwy.net:31650

# Optional. Only set this if you're using an MQTT broker for GPS telemetry
# (paper, Table 11 — "evaluated" as an option, not the primary path). Leave
# unset to skip it entirely; the REST /api/tracking endpoint works either way.
MQTT_BROKER_URL=
MQTT_TOPIC=drs/bus/+/location

# Port the Express server listens on locally.
PORT=4000

# Secret used to sign/verify the JWTs issued by POST /api/auth/login (see
# middleware/auth.js). Set a real random value in production — the code
# falls back to a dev-only default if this is unset, which is fine for
# local development but must not be relied on when deployed.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (your Vite dev
# server and your deployed frontend URL). Also used for the Socket.io CORS policy.
CORS_ORIGIN=http://localhost:5173
