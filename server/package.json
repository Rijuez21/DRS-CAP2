{
  "name": "drs-bus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + MySQL backend for the DRS Bus Management System, designed to run against a Railway MySQL database.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:init": "node src/db/init.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5"
  }
}
