# Railway (Railpack) serves the built site with Caddy and uses this file
# instead of its default. Same as the default, plus cache headers: without
# them browsers guess how long to keep index.html and keep showing the
# previous build after a deploy until the user refreshes.
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# The <meta> CSP in index.html covers scripts, styles and connections,
	# but browsers ignore frame-ancestors in a <meta> tag, so clickjacking
	# protection (no other site may frame this one) has to be a header.
	# The _headers file Vite writes is for Netlify / Cloudflare Pages only;
	# Caddy on Railway doesn't read it.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		# Location: terminal map, Flag a Bus, driver GPS. Camera: scanning
		# QR e-tickets at the terminal.
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}

	# Built JS/CSS have a content hash in their names, so a new build gets
	# new names: safe to cache for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html and every app route that falls back to it)
	# must be re-checked with the server each time, so a deploy shows up on
	# the next page load.
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	root * /app/dist
	encode gzip zstd
	try_files {path} {path}.html {path}/index.html /index.html
	file_server {
		hide .git .env*
	}
}
