diff --git a/drs-bus-main/src/lib/groupBy.js b/drs-bus-main/src/lib/groupBy.js
new file mode 100644
index 0000000..e84c158
--- /dev/null
+++ b/drs-bus-main/src/lib/groupBy.js
@@ -0,0 +1,11 @@
+// Keeps first-appearance order, so the list's own sort decides which
+// chunk comes first and how the items inside it are ordered.
+export function groupBy(rows, keyOf) {
+  const groups = new Map();
+  for (const row of rows) {
+    const k = keyOf(row);
+    if (!groups.has(k)) groups.set(k, []);
+    groups.get(k).push(row);
+  }
+  return [...groups.entries()];
+}
